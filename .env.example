# ============================================
# TALENTSTREAM HR PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values
# NEVER commit .env to GitHub
# ============================================

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/talentstream

# === REDIS ===
REDIS_URL=redis://localhost:6379/0

# === S3 / MINIO STORAGE ===
S3_ENDPOINT=https://your-minio-endpoint.com:4443/s3
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_VERIFY_SSL=false

# === OPENAI ===
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_PARSING=gpt-4o-mini
OPENAI_MODEL_VOICE=gpt-4o
OPENAI_MODEL_WEIGHTS=gpt-4o

# === SMALLEST.AI STT ===
SMALLEST_AI_API_KEY=your-smallest-ai-key

# === LIVEKIT ===
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret
LIVEKIT_WS_URL=wss://your-livekit-host
LIVEKIT_HTTP_URL=https://your-livekit-host

# === SENDGRID / EMAIL ===
SENDGRID_API_KEY=SG.your-sendgrid-key
EMAIL_FROM=noreply@yourcompany.com

# === LLAMAPARSE ===
LLAMAPARSE_API_KEY=your-llamaparse-key

# === SECURITY ===
SECRET_KEY=your-fastapi-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === RATE LIMITING ===
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# === MONITORING (optional) ===
SENTRY_DSN=https://your-sentry-dsn
UPTIMEROBOT_API_KEY=your-uptimerobot-key
