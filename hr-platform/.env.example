# =============================================================================
# TALENTSTREAM HR PLATFORM — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual secrets/keys.
# NEVER commit .env to version control. .env.example is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION
# -----------------------------------------------------------------------------

API_ENV=production                    # Options: development, staging, production
API_PORT=8000                         # FastAPI server port inside container
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production  # JWT signing, session encryption

# -----------------------------------------------------------------------------
# 2. DATABASE
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:pass@db:5432/talentstream
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# The 'db' hostname resolves to the PostgreSQL container via Docker DNS

# -----------------------------------------------------------------------------
# 3. REDIS (Celery Broker + SSE Pub/Sub + Cache)
# -----------------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0
# Format: redis://HOST:PORT/DB_INDEX
# DB 0 = Celery broker + task results
# DB 1 = SSE Pub/Sub channels (optional separation)

# -----------------------------------------------------------------------------
# 4. S3 / MINIO OBJECT STORAGE
# -----------------------------------------------------------------------------

S3_ENDPOINT=https://s3.amazonaws.com           # For AWS S3
# S3_ENDPOINT=http://minio:9000                # For local MinIO (development)
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=hr-talentstream-storage
S3_REGION=us-east-1                            # AWS region (optional for MinIO)

# Resume storage path: s3://{S3_BUCKET_NAME}/resumes/{job_id}/{candidate_id}/resume.pdf
# Voice storage path: s3://{S3_BUCKET_NAME}/user_voice/{interview_id}/candidate_voice.ogg
# Report storage path: s3://{S3_BUCKET_NAME}/reports/{candidate_id}.pdf

# -----------------------------------------------------------------------------
# 5. OPENAI API (Formatting + Scoring + Weight Setting)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL_FORMATTING=gpt-4o-mini          # BB2-B: Resume → structured JSON
OPENAI_MODEL_SCORING=gpt-4o-mini             # BB3: Bias-stripped profile scoring
OPENAI_MODEL_WEIGHTS=gpt-4o                  # BB6: Job weight generation (deterministic)
OPENAI_BASE_URL=https://api.openai.com/v1    # Change for Azure OpenAI or proxy

# -----------------------------------------------------------------------------
# 6. LLAMAPARSE CLOUD API (Document Parsing — BB2-A)
# -----------------------------------------------------------------------------

LLAMAPARSE_API_KEY=your-llamaparse-api-key
LLAMAPARSE_MODE=agentic                        # Options: agentic, cost-effective
# Agentic = better quality, slower, more expensive
# Cost-effective = fallback mode after agentic failure (1 retry)

# -----------------------------------------------------------------------------
# 7. SMALLEST.AI STT API (Speech Analysis — BB5)
# -----------------------------------------------------------------------------

SMALLEST_AI_API_KEY=your-smallest-ai-api-key
SMALLEST_AI_MODEL=stt-1                        # Speech-to-text model
SMALLEST_AI_LANGUAGE=en                          # Default language code

# -----------------------------------------------------------------------------
# 8. LIVEKIT CLOUD (WebRTC — BB4, BB5, Interview Flow)
# -----------------------------------------------------------------------------

LIVEKIT_URL=wss://livekit.your-domain.com      # WebSocket URL for LiveKit Cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_SECRET=your-livekit-api-secret
LIVEKIT_WS_URL=wss://livekit.your-domain.com   # Same as LIVEKIT_URL, explicit for SDK

# Room configuration (hard limits from architecture)
LIVEKIT_MAX_ROOM_DURATION_MINS=35                # Hard room timeout
LIVEKIT_EMPTY_TIMEOUT_SEC=600                  # 10 min — room stays alive after disconnect

# -----------------------------------------------------------------------------
# 9. SENDGRID / AWS SES (Email Delivery — Interview Invites)
# -----------------------------------------------------------------------------

SENDGRID_API_KEY=SG.your-sendgrid-api-key
# OR for AWS SES:
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@yourcompany.com

EMAIL_FROM_NAME=TalentStream HR
EMAIL_FROM_ADDRESS=noreply@yourcompany.com
EMAIL_TRACKING_DOMAIN=yourdomain.com           # For open/click tracking URLs

# -----------------------------------------------------------------------------
# 10. PLATFORM LIMITS & COST CONTROLS
# -----------------------------------------------------------------------------

DAILY_RESUME_LIMIT=50                          # Per HR manager per day
MAX_INTERVIEW_DURATION_MINS=35                 # Must match LIVEKIT_MAX_ROOM_DURATION_MINS
CELERY_STALE_CHECK_INTERVAL_SEC=1800           # 30 minutes — safety daemon interval

# OpenAI cost alert threshold
OPENAI_MONTHLY_BUDGET_ALERT=50.00              # USD — alert when approaching

# -----------------------------------------------------------------------------
# 11. RATE LIMITING (Redis-backed slowapi)
# -----------------------------------------------------------------------------

RATE_LIMIT_PUBLIC_INVITE=10/minute             # GET /interview/{token}
RATE_LIMIT_PUBLIC_START=5/minute               # POST /api/interviews/start
RATE_LIMIT_PUBLIC_UPLOAD=50/day                # POST /api/candidates/upload
RATE_LIMIT_AUTH_JOBS=20/minute                 # POST /api/jobs
RATE_LIMIT_AUTH_INVITE=10/minute               # POST /api/interviews/{id}/invite
RATE_LIMIT_SSE_CONCURRENT=5                    # Per user concurrent SSE connections

# -----------------------------------------------------------------------------
# 12. MONITORING & LOGGING
# -----------------------------------------------------------------------------

SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id  # Optional — error tracking
LOG_LEVEL=INFO                                 # DEBUG, INFO, WARNING, ERROR
ENABLE_AUDIT_LOG=true                          # Log every DB write with timestamp

# -----------------------------------------------------------------------------
# 13. COMPANY CONFIGURATION (For Candidate Portal)
# -----------------------------------------------------------------------------

COMPANY_NAME=Your Company Name                 # Shown on interview landing page
COMPANY_LOGO_URL=https://yourcdn.com/logo.png  # Optional — shown on portal

# -----------------------------------------------------------------------------
# 14. DEVELOPMENT / TESTING OVERRIDES
# -----------------------------------------------------------------------------

# Set to true to skip external API calls and use mocks (for unit tests)
TEST_MODE=false

# Mock S3 bucket for local testing (when TEST_MODE=true)
# MOCK_S3_PATH=/tmp/talentstream-mock-s3

# Mock SendGrid (prints to console instead of sending)
# MOCK_EMAIL=true

# -----------------------------------------------------------------------------
# 15. SECURITY
# -----------------------------------------------------------------------------

# CORS origins for frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Invite token TTL (seconds) — must match Redis TTL
INVITE_TOKEN_TTL_SEC=86400                     # 24 hours

# Password hashing (if auth is added later)
# BCRYPT_ROUNDS=12

# =============================================================================
# END OF FILE
# =============================================================================
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values marked with "your-..."
# 3. Never commit .env to git
# 4. In production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault)
# =============================================================================
